# Bloquear acceso web directo a archivos Excel y JSON de caché
<FilesMatch "\.(xlsx|xls|csv|json|cache)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Desactivar listado de directorio
Options -Indexes

# Bloquear acceso web directo a DB.xlsx, cache.json y archivos de configuración
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
